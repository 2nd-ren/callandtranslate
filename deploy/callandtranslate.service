[Unit]
Description=Call & Translate Node application
After=network.target mongod.service
Wants=mongod.service

[Service]
Type=simple
User=callandtranslate
Group=callandtranslate
WorkingDirectory=/opt/callagent
EnvironmentFile=/etc/callandtranslate.env
ExecStart=/usr/bin/node index.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/callagent

[Install]
WantedBy=multi-user.target
